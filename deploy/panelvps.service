[Unit]
Description=PanelVPS - 轻量服务器管理面板
Documentation=https://github.com/Everything-is-one/panelvps
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/panelvps
ExecStart=/opt/panelvps/bin/panelvps serve -config /opt/panelvps/conf/panel.yaml
Restart=always
RestartSec=5s

# Go 运行时内存上限：对应「空载 ≤ 50MB」这条硬指标
Environment=GOMEMLIMIT=64MiB
Environment=GOGC=50

# 防止异常增长拖垮同机的 Xray / Nginx
MemoryMax=192M

# ---- 加固 ----
# 整机只读，仅放行面板必须写入的目录
ProtectSystem=strict
# 注意：/etc/nginx/conf.d 与 /etc/nftables.d 必须可写，否则建站与防火墙下发会失败；
# /etc/letsencrypt 与 /var/lib/letsencrypt 是 certbot 的工作目录；
# /var/www 是站点根目录与 ACME 校验目录。
# 前置 "-" 表示目录不存在时跳过，否则 systemd 会因挂载失败而拒绝启动。
ReadWritePaths=-/opt/panelvps/data -/opt/panelvps/conf \
               -/etc/nginx/conf.d -/etc/nftables.d -/etc/sysctl.d \
               -/etc/letsencrypt -/var/lib/letsencrypt -/var/log/letsencrypt \
               -/var/www -/var/log -/run
PrivateTmp=yes
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# AF_NETLINK 必须保留：Web 终端里跑 ip / ss / systemctl 都依赖它，
# 少了会出现「终端里 ip a 报 Protocol not supported」这种诡异现象。
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# 仅保留面板确实需要的能力：改防火墙、切用户、读任意文件
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_CHOWN CAP_DAC_OVERRIDE CAP_KILL CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_CHOWN CAP_DAC_OVERRIDE CAP_KILL CAP_SETUID CAP_SETGID

# 日志走 journald（PRD ADR-08）
StandardOutput=journal
StandardError=journal
SyslogIdentifier=panelvps

[Install]
WantedBy=multi-user.target
