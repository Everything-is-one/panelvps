[Unit]
Description=PanelVPS - 轻量服务器管理面板
Documentation=https://github.com/Everything-is-one/panelvps
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/panelvps
ExecStart=/opt/panelvps/bin/panelvps serve -config /opt/panelvps/conf/panel.yaml
Restart=always
RestartSec=5s

# Go 运行时内存上限：对应「空载 ≤ 50MB」这条硬指标
Environment=GOMEMLIMIT=64MiB
Environment=GOGC=50

# 这个限额罩住整个 cgroup，Xray 作为子进程也在里面
MemoryMax=256M

# ---- 加固 ----
# 别用白名单。这个单元被改过两轮，两次都是白名单漏了路径：
#   1. strict + 白名单 → 文件管理器 mkdir /home/aaa 报 read-only；
#   2. full + 零散白名单 → 软件商店装 Xray 时 mkdir /usr/local/share/xray
#      报 read-only。后者更隐蔽：systemd 对白名单里**不存在**的路径是
#      静默跳过的（- 前缀），目录没建就没有 bind mount，照样只读。
#
# 面板的本职就是改系统：装包（apt 写 /usr /var/lib/dpkg /etc）、下发站点与
# 防火墙配置、切换内核参数。full 下这些全被挡住，功能就是缺的。
#
# 所以：full + 明确放开 /usr /etc /var。/boot 与 /efi 仍然只读，
# 改不了内核与引导。写保护对 root 面板的收益本来有限（它能写 systemd
# 单元、带 CAP_DAC_OVERRIDE），真正有用的是下面这些：能力集、地址族、
# 内核参数与模块、cgroup —— 这些才是挡提权与横向移动的地方。
ProtectSystem=full
ReadWritePaths=-/etc -/usr -/var
# 再点名软件商店实际落地的目录。
#
# 两个真实原因让「-/usr 放开」不等于「/usr/local/bin 可写」：
#   1. 单元是旧版本（Web 升级只换二进制，不动 /etc/systemd/system），
#      老单元的零散白名单里没有 /usr/local/bin；
#   2. ReadWritePaths 的 bind 挂载不覆盖更内层的独立挂载点，而 systemd
#      对**不存在**的路径是静默跳过的 —— /usr/local 若从宿主机 bind 进来，
#      /usr 整体放开也写不进去。
# 点名写一遍成本为零，装 Xray 时 mkdir /usr/local/bin 就不会再报
# read-only file system。install.sh 会在启动前把这些目录建好。
ReadWritePaths=-/usr/local/bin -/usr/local/share -/usr/local/etc -/etc/systemd/system -/etc/xray
# /home 与 /root 必须可写：站点、备份、用户目录都在这里。
# /tmp 与系统共用：PrivateTmp 会让文件管理器看到的 /tmp 和 SSH 里不是同一个目录，
# 用户上传完再登录找不到文件，这是纯粹的困惑源。
PrivateTmp=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# AF_NETLINK 必须保留：Web 终端里跑 ip / ss / systemctl 都依赖它，
# 少了会出现「终端里 ip a 报 Protocol not supported」这种诡异现象。
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# 仅保留面板确实需要的能力：改防火墙、切用户、读任意文件
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_CHOWN CAP_DAC_OVERRIDE CAP_KILL CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_CHOWN CAP_DAC_OVERRIDE CAP_KILL CAP_SETUID CAP_SETGID

# 日志走 journald（PRD ADR-08）
StandardOutput=journal
StandardError=journal
SyslogIdentifier=panelvps

[Install]
WantedBy=multi-user.target
