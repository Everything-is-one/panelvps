[Unit]
Description=PanelVPS - 轻量服务器管理面板
Documentation=https://github.com/Everything-is-one/panelvps
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/panelvps
ExecStart=/opt/panelvps/bin/panelvps serve -config /opt/panelvps/conf/panel.yaml
Restart=always
RestartSec=5s

# Go 运行时内存上限：对应「空载 ≤ 50MB」这条硬指标
Environment=GOMEMLIMIT=64MiB
Environment=GOGC=50

# 这个限额罩住整个 cgroup，Xray 作为子进程也在里面
MemoryMax=256M

# ---- 加固 ----
# 只保护系统二进制与 /etc，不再把整机挂成只读。
#
# 之前用 strict + ReadWritePaths 白名单，结果是用户在文件管理器里
# mkdir /home/aaa 直接报 read-only file system —— 面板的本职就是管文件，
# 白名单永远列不全用户想写的地方（/home、/root、/srv、/mnt、/opt）。
# full 仍然让 /usr、/boot、/etc 只读，能挡住替换系统二进制这类持久化。
ProtectSystem=full
# /home 与 /root 必须可写：站点、备份、用户目录都在这里。
# /tmp 与系统共用：PrivateTmp 会让文件管理器看到的 /tmp 和 SSH 里不是同一个目录，
# 用户上传完再登录找不到文件，这是纯粹的困惑源。
PrivateTmp=no
# full 下 /etc 只读，这些子目录要写：建站、防火墙下发、内核参数、安装服务单元
ReadWritePaths=-/opt/panelvps/data -/opt/panelvps/conf \
               -/etc/nginx/conf.d -/etc/nftables.d -/etc/sysctl.d \
               -/etc/systemd/system \
               -/etc/letsencrypt -/var/lib/letsencrypt -/var/log/letsencrypt \
               -/etc/xray -/usr/local/bin -/usr/local/share/xray
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# AF_NETLINK 必须保留：Web 终端里跑 ip / ss / systemctl 都依赖它，
# 少了会出现「终端里 ip a 报 Protocol not supported」这种诡异现象。
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# 仅保留面板确实需要的能力：改防火墙、切用户、读任意文件
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_CHOWN CAP_DAC_OVERRIDE CAP_KILL CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_CHOWN CAP_DAC_OVERRIDE CAP_KILL CAP_SETUID CAP_SETGID

# 日志走 journald（PRD ADR-08）
StandardOutput=journal
StandardError=journal
SyslogIdentifier=panelvps

[Install]
WantedBy=multi-user.target
