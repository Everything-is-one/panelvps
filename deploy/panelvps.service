[Unit]
Description=PanelVPS - 轻量服务器管理面板
Documentation=https://github.com/Everything-is-one/panelvps
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/panelvps
ExecStart=/opt/panelvps/bin/panelvps serve -config /opt/panelvps/conf/panel.yaml
Restart=always
RestartSec=5s

# Go 运行时内存上限：对应「空载 ≤ 50MB」这条硬指标
Environment=GOMEMLIMIT=64MiB
Environment=GOGC=50

# 这个限额罩住整个 cgroup，Xray 作为子进程也在里面
MemoryMax=256M

# ---- 写保护：默认放开，只读点名 ----
# 这个单元被白名单坑过三轮，一次比一次隐蔽：
#   1. strict + 白名单 → 文件管理器 mkdir /home/aaa 报 read-only；
#   2. full + 零散白名单 → 装 Xray 时 mkdir /usr/local/share/xray 报 read-only；
#   3. full + ReadWritePaths=-/etc -/usr -/var → 装 Nginx 时 dpkg 在
#      /etc/default/nginx 报 read-only（单元若是 0.4 之前装的，仍是 strict，
#      整机只读）。
#
# 根本矛盾：白名单是「枚举所有要写的目录」，而面板的本职就是替用户改系统
# （装包写 /usr /etc /var、建站写 /etc/nginx、防火墙写 /etc/nftables.conf、
# 换源写 /etc/sysctl.d），枚举永远漏得掉；何况 systemd 对白名单里
# **不存在**的路径是静默跳过的（- 前缀），同一个单元在不同机器上行为还不一样。
#
# 所以反过来写：默认全可写，只把「面板绝不该碰」的两处点成只读。
# 故障面从「N 个可能遗漏的白名单」缩成「2 个明确的只读路径」，
# 出问题时错误也直白（写到 /boot 才报 read-only）。
#
# 写保护对 root 面板的边际收益本来就低（它能写 systemd 单元、带
# CAP_DAC_OVERRIDE）。真正挡提权与横向移动的是下面这些：能力集、地址族、
# 内核参数与模块、cgroup —— 那些一律保留。
ProtectSystem=no
ReadOnlyPaths=-/boot -/efi
# /home 与 /root 必须可写：站点、备份、用户目录都在这里。
# /tmp 与系统共用：PrivateTmp 会让文件管理器看到的 /tmp 和 SSH 里不是同一个目录，
# 用户上传完再登录找不到文件，这是纯粹的困惑源。
PrivateTmp=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# AF_NETLINK 必须保留：Web 终端里跑 ip / ss / systemctl 都依赖它，
# 少了会出现「终端里 ip a 报 Protocol not supported」这种诡异现象。
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# 仅保留面板确实需要的能力：改防火墙、切用户、读任意文件、改文件权限
#
# CAP_FOWNER 是 apt 带来的硬需求，少它会看到一串
#   W: chmod 0600 of file /var/lib/apt/lists/partial/..._InRelease failed
#      - Item::QueueURI (1: Operation not permitted)
# 原因：apt 的 sandbox 用 _apt 用户下载，落到 lists/partial 的文件属主是
# _apt；root 再去 chmod 时，对「不属于自己」的文件做权限修改需要
# CAP_FOWNER（CAP_CHOWN 只管改属主，不管改权限位）。少了它 apt 只打
# warning 不中断，所以容易被当成噪音忽略 —— 但同样的权限会被文件管理器
# 改权限、站点部署 chown/chmod 用到，早晚会撞上。
#
# CAP_NET_BIND_SERVICE 同理，缺了它装 Nginx 会「装成功却判失败」：
#   nginx: [emerg] bind() to 0.0.0.0:80 failed (13: Permission denied)
# 因为 nginx -t 要真开一遍监听套接字来验证配置，而它是面板的子进程，
# 继承这份边界集。内核在 inet_bind 里先查端口权限、再查是否被占用，
# 所以哪怕 nginx 自己（独立单元、完整能力）已经正常监听 80，面板这边
# 依旧只得到 EACCES。面板还要直接绑低端口：中转规则常写 :443、
# 面板自身 listen 也可能配成 :80。
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_NET_RAW CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_KILL CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_NET_RAW CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_KILL CAP_SETUID CAP_SETGID

# 日志走 journald（PRD ADR-08）
StandardOutput=journal
StandardError=journal
SyslogIdentifier=panelvps

[Install]
WantedBy=multi-user.target
